# Keep secrets out of source control.
OPENAI_API_KEY=

# Choose by measured workload, not by prestige. Terra is the balanced default.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium

# Trace structure, but exclude prompt/tool payloads by default.
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=0

# The examples fail closed unless every input row declares itself synthetic.
CODEX_ONES_SYNTHETIC_ONLY=1

# Optional MCP settings. Use a Python executable from the separate MCP v2 venv.
MCP_SERVER_PYTHON=
MCP_SERVER_URL=

